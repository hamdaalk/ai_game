# Survey Says game. Needs only survey-says.html next to this file.
# The line below writes the small game server (it serves the page and links the host phone to the big screen).
FROM node:20-alpine
WORKDIR /app
COPY survey-says.html ./
RUN echo '' | base64 -d > server.js
ENV PORT=10000
EXPOSE 10000
CMD ["node", "server.js"]
